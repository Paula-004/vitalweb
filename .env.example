NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=10000
NEXT_PUBLIC_API_RETRIES=2

# Cada capacidad usa la API sólo si su endpoint está completo.
# Si queda vacío, el servicio responde con los mocks de mocks/ y la pantalla sigue funcionando.

# --- Confirmados por Gestion-de-clientes ---
# Cuentas de cliente: email + contraseña. El registro acepta además `sellerCode`,
# el código del vendedor de zona; llega precargado con /registro?v=CODIGO y, si no
# viene, la compra queda como venta directa.
NEXT_PUBLIC_API_CUSTOMER_LOGIN_ENDPOINT=/storefront/auth/login
NEXT_PUBLIC_API_CUSTOMER_REGISTER_ENDPOINT=/storefront/auth/register
NEXT_PUBLIC_API_CUSTOMER_ME_ENDPOINT=/storefront/auth/me
NEXT_PUBLIC_API_PRODUCTS_ENDPOINT=/storefront/products
NEXT_PUBLIC_API_CATEGORIES_ENDPOINT=/storefront/categories
NEXT_PUBLIC_API_DAILY_MENU_ENDPOINT=/storefront/menus/daily
NEXT_PUBLIC_API_WEEKLY_MENU_ENDPOINT=/storefront/menus/weekly
# El pedido acepta la sesión del cliente (y también sigue aceptando invitados).
NEXT_PUBLIC_API_ORDERS_ENDPOINT=/storefront/orders
NEXT_PUBLIC_API_MY_ORDERS_ENDPOINT=/storefront/me/orders
NEXT_PUBLIC_API_MEAL_BALANCE_ENDPOINT=/storefront/me/meal-balance

# --- Pendientes en el backoffice: completar cuando publique cada ruta ---
# Prioridad 2: direcciones y entrega
NEXT_PUBLIC_API_ADDRESSES_ENDPOINT=
NEXT_PUBLIC_API_SHIPPING_ZONES_ENDPOINT=
NEXT_PUBLIC_API_SHIPPING_QUOTE_ENDPOINT=
NEXT_PUBLIC_API_TIME_SLOTS_ENDPOINT=
# Sugeridos: /storefront/me/addresses, /storefront/shipping/zones,
#            /storefront/shipping/quote, /storefront/shipping/time-slots

# Prioridad 5: cupones y promociones
NEXT_PUBLIC_API_PROMOTIONS_ENDPOINT=/storefront/promotions
NEXT_PUBLIC_API_COUPONS_ENDPOINT=
# Sugeridos: /storefront/promotions y /storefront/coupons/validate

# Prioridad 6: favoritos
NEXT_PUBLIC_API_FAVORITES_ENDPOINT=/storefront/me/favorites
# Sugerido: /storefront/me/favorites

# Prioridad 7: recuperación de contraseña
NEXT_PUBLIC_API_PASSWORD_RECOVERY_ENDPOINT=
NEXT_PUBLIC_API_PASSWORD_RESET_ENDPOINT=
# Sugeridos: /storefront/auth/password/recovery y /storefront/auth/password/reset

# Prioridad 8: configuración del comercio y recomendaciones
NEXT_PUBLIC_API_STORE_CONFIG_ENDPOINT=
NEXT_PUBLIC_API_RECOMMENDATIONS_ENDPOINT=
# Sugeridos: /storefront/config y /storefront/recommendations

# --- Pagos ---
# El flujo actual está simulado de punta a punta. Mientras estas variables estén vacías,
# paymentService responde con una transacción de demostración y nunca cobra nada.
# Ver README, sección "Conectar pagos reales".
NEXT_PUBLIC_PAYMENT_PROVIDER=
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=
NEXT_PUBLIC_API_PAYMENT_ENDPOINT=
NEXT_PUBLIC_API_PAYMENT_CREATE_ENDPOINT=
NEXT_PUBLIC_API_PAYMENT_STATUS_ENDPOINT=
# Sugeridos: /storefront/payment-methods, /storefront/payments y /storefront/payments/:id

# --- Imágenes ---
# Hosts extra autorizados para <Image /> de Next, separados por coma. El host de
# NEXT_PUBLIC_API_URL ya se autoriza solo; acá va el bucket o la CDN.
# Se lee al arrancar: después de cambiarla hay que reiniciar el server.
# Ej.: vitalfood-img.s3.sa-east-1.amazonaws.com
NEXT_PUBLIC_IMAGE_HOSTS=
